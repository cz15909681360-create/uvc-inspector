<Window x:Class="UvcInspector.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="UVC 编码与码流检测 · 原生桌面版" Icon="App.ico" Width="1320" Height="930" MinWidth="1040" MinHeight="720" Background="#F4F7FC"
  FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#14243F" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Background="#F4F7FC">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#13243F">
      <DockPanel Margin="22,26,22,20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
          <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" Background="#2563EB" Margin="0,0,12,0"><TextBlock Text="U" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="UVC INSPECTOR" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="编码与码流检测" Foreground="#A5B7D4" Margin="0,4,0,0" FontSize="12"/></StackPanel>
          </StackPanel>
          <Border Background="#213858" CornerRadius="6" Padding="9,6" Margin="0,19,0,0" HorizontalAlignment="Left"><TextBlock Text="原生桌面版  /  2.1.0" Foreground="#BBD3FF" FontSize="11"/></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
          <Border Background="#1B3150" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="检测引擎" Foreground="#A5B7D4" FontSize="11"/><TextBlock Text="{Binding EngineText}" Foreground="#D6E5FE" FontSize="11" Margin="0,6,0,0" LineHeight="17"/></StackPanel></Border>
          <Button Content="选择引擎" Command="{Binding LocateEngineCommand}" Background="#213858" BorderBrush="#3A506D" Foreground="#DFEAFE" Margin="0,10,0,0"/>
          <Button Content="使用说明" Command="{Binding HelpCommand}" Background="Transparent" BorderBrush="#3A506D" Foreground="#B8CAE3" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="采集设置" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="视频设备" Foreground="#B7C7DF" Margin="0,0,0,7" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="视频设备"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Button Content="刷新设备" Command="{Binding RefreshCommand}" Background="#213858" BorderBrush="#3A506D" Foreground="#E0EBFD" Margin="0,9,0,17"/>
            <TextBlock Text="所选模式" Foreground="#B7C7DF" FontSize="12"/>
            <Border Background="#1B3150" CornerRadius="8" Padding="11" Margin="0,7,0,16"><TextBlock Text="{Binding SelectedFormatText}" Foreground="#DDEAFF" FontWeight="SemiBold" LineHeight="20"/></Border>
            <Grid IsEnabled="{Binding CanEdit}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="宽度 / px" Foreground="#B7C7DF" Margin="0,0,0,7" FontSize="12"/><TextBlock Grid.Column="2" Text="高度 / px" Foreground="#B7C7DF" Margin="0,0,0,7" FontSize="12"/>
              <TextBox Grid.Row="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="宽度"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="高度"/>
              <TextBlock Grid.Row="3" Text="帧率 / fps" Foreground="#B7C7DF" Margin="0,0,0,7" FontSize="12"/><TextBlock Grid.Row="3" Grid.Column="2" Text="测试 / 秒" Foreground="#B7C7DF" Margin="0,0,0,7" FontSize="12"/>
              <TextBox Grid.Row="4" Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="帧率"/><TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="测试秒数"/>
            </Grid>
            <TextBlock Text="{Binding ModeNote}" Foreground="#91A6C5" FontSize="11" LineHeight="18" Margin="0,12,0,16"/>
            <Button Content="{Binding TestButtonText}" Command="{Binding TestCommand}" Style="{StaticResource PrimaryButton}" Padding="12,13"/>
            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Content="{Binding PreviewButtonText}" Command="{Binding PreviewCommand}" Background="#213858" BorderBrush="#3A506D" Foreground="#E0EBFD" Padding="8,10"/>
              <Button Grid.Column="2" Content="停止" Command="{Binding StopCommand}" Background="#213858" BorderBrush="#3A506D" Foreground="#FFC4C4" Padding="8,10"/>
            </Grid>
            <TextBlock Text="测试前自动关闭本页预览。请先关闭会议软件、OBS 等其他相机占用。" Foreground="#91A6C5" FontSize="11" LineHeight="18" Margin="0,15,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MainContent" Margin="26,25,26,24">
        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="视频输入检测" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="清楚识别编码，准确理解码流" Style="{StaticResource Small}" Margin="0,6,0,0"/></StackPanel>
          <Button Grid.Column="1" Content="导出报告" Command="{Binding ExportCommand}" VerticalAlignment="Center" Padding="18,10"/>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,18">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <Border Background="{Binding StateBrush}" CornerRadius="3"/>
            <StackPanel Grid.Column="1" Margin="13,0,14,0"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StateDetail}" Style="{StaticResource Small}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding ResultLabel}" Style="{StaticResource Small}" HorizontalAlignment="Right" Margin="0,0,0,7"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Foreground="{Binding StateBrush}" Background="#E8EDF5" BorderThickness="0"/></StackPanel>
          </Grid>
        </Border>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Background="#EFF5FF" BorderBrush="#CBDCFF"><StackPanel><TextBlock Text="实际视频编码" Foreground="#3763A4" FontSize="12"/><TextBlock Text="{Binding CodecText}" Style="{StaticResource Metric}" Foreground="#1D4ED8"/><TextBlock Text="{Binding PixelText}" Foreground="#4B6B9C" FontSize="12" ToolTip="实际像素格式，与视频编码分别识别"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Background="#EDF9F4" BorderBrush="#BEE5D5"><StackPanel><TextBlock Text="视频数据码率" Foreground="#377866" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RateText}" Style="{StaticResource Metric}" Foreground="#047857"/><TextBlock Text="Mbps" FontSize="12" Foreground="#5E8B7B" VerticalAlignment="Bottom" Margin="7,0,0,10"/></StackPanel><TextBlock Text="视频包字节 / 媒体区间" Foreground="#5E8B7B" FontSize="12"/></StackPanel></Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Background="#F4F0FE" BorderBrush="#DDD1FA"><StackPanel><TextBlock Text="采集帧率" Foreground="#765AA9" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FpsText}" Style="{StaticResource Metric}" Foreground="#7C3AED"/><TextBlock Text="fps" FontSize="12" Foreground="#8A77AC" VerticalAlignment="Bottom" Margin="7,0,0,10"/></StackPanel><TextBlock Text="FFmpeg 帧计数 / 媒体区间" Foreground="#8A77AC" FontSize="12"/></StackPanel></Border>
          <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="色度采样" Style="{StaticResource Small}"/><TextBlock Text="{Binding ChromaText}" Style="{StaticResource Metric}" FontSize="23"/><TextBlock Text="由实际像素格式识别" Style="{StaticResource Small}"/></StackPanel></Border>
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="样本位深" Style="{StaticResource Small}"/><TextBlock Text="{Binding DepthText}" Style="{StaticResource Metric}" FontSize="23"/><TextBlock Text="位深与存储字节分别计算" Style="{StaticResource Small}"/></StackPanel></Border>
          <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="未压缩存储参考 / Mbps" Style="{StaticResource Small}"/><TextBlock Text="{Binding ReferenceText}" Style="{StaticResource Metric}" FontSize="23" Foreground="#B45309"/><TextBlock Text="{Binding ReferenceHint}" Style="{StaticResource Small}"/></StackPanel></Border>
        </Grid>
        <Grid x:Name="Workspace" Height="300" MinHeight="240"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="15,14"><TextBlock Text="{Binding ModeCountText}" Style="{StaticResource Small}" DockPanel.Dock="Right"/><TextBlock Text="设备支持模式" FontSize="14" FontWeight="SemiBold"/></DockPanel>
              <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="设备支持模式">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="编码" Binding="{Binding Encoding}" Width="85"/>
                    <DataGridTextColumn Header="像素格式" Binding="{Binding PixelLabel}" Width="115"/>
                    <DataGridTextColumn Header="尺寸" Binding="{Binding SizeLabel}" Width="145"/>
                    <DataGridTextColumn Header="帧率" Binding="{Binding FpsLabel}" Width="105"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="暂无支持模式&#10;连接设备后刷新" Foreground="#8796AA" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Modes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="15,14"><TextBlock Text="窗口内预览" Foreground="#2563EB" FontSize="11" DockPanel.Dock="Right"/><TextBlock Text="实时画面" FontSize="14" FontWeight="SemiBold"/></DockPanel>
              <Border x:Name="PreviewSurface" Grid.Row="1" Background="#111E33" Margin="10,0,10,0" CornerRadius="8" ClipToBounds="True">
                <Grid><Image Source="{Binding PreviewImage}" Stretch="Uniform"/><StackPanel Visibility="{Binding PreviewPlaceholderVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◎" Foreground="#6382AE" FontSize="39" HorizontalAlignment="Center"/><TextBlock Text="画面预览" Foreground="#C2CFE3" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="在左侧点击实时预览" Foreground="#8197B9" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
              </Border>
              <TextBlock Grid.Row="2" Text="{Binding PreviewCaption}" Style="{StaticResource Small}" Margin="13,10,13,12" FontSize="11"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Margin="0,5,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Thumb x:Name="WorkspaceResizeThumb" Height="28" Cursor="SizeNS" Focusable="True"
            AutomationProperties.Name="调整模式列表与预览区域高度" ToolTip="上下拖动调整高度；方向键每次调整 20，Home 恢复自适应"
            DragDelta="ResizeWorkspace" DragCompleted="SaveWorkspaceHeight" KeyDown="WorkspaceResizeKeyDown">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Border x:Name="ResizeTrack" Background="Transparent" CornerRadius="6">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,9,0"><Border Width="30" Height="2" Background="#7799CC" CornerRadius="1"/><Border Width="30" Height="2" Background="#7799CC" CornerRadius="1" Margin="0,3,0,0"/></StackPanel>
                    <TextBlock Text="上下拖动调整区域高度" Foreground="#6480A8" FontSize="11"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeTrack" Property="Background" Value="#E2ECFD"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ResizeTrack" Property="Background" Value="#E2ECFD"/></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="ResizeTrack" Property="Background" Value="#D3E3FD"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
          <Button x:Name="AutoHeightButton" Grid.Column="1" Content="自适应高度" Click="ResetWorkspaceHeight" Padding="10,4" Margin="12,0,0,0" FontSize="11" ToolTip="根据窗口大小自动分配预览高度"/>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,12">
          <StackPanel><UniformGrid Columns="3"><TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/><TextBlock Text="{Binding DurationText}" FontWeight="SemiBold"/><TextBlock Text="{Binding BytesText}" FontWeight="SemiBold"/></UniformGrid><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding FrameText}" Style="{StaticResource Small}" DockPanel.Dock="Right"/><TextBlock Text="{Binding TimingText}" Style="{StaticResource Small}" FontSize="11"/></DockPanel></StackPanel>
        </Border>
        <Border Background="#FFF8EB" BorderBrush="#F0DBB3" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,0,0,13">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="提醒" Foreground="#A16207" FontWeight="SemiBold" Margin="0,0,13,0"/><TextBlock Grid.Column="1" Text="{Binding WarningText}" Foreground="#846632" FontSize="12" LineHeight="19"/></Grid>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,10">
          <Expander Header="诊断记录" IsExpanded="False" Foreground="#64748B"><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" BorderThickness="0" Background="#F8FAFD" MinHeight="100" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0"/></Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
